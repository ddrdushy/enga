# Leave these empty to run in demo mode (sample data kept on the phone).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Names shown on the login screen, in order. Each needs a Supabase user <name>@<VITE_AUTH_DOMAIN>.
VITE_MEMBERS=Dushy,Ali,Kiru
VITE_AUTH_DOMAIN=enga.app
# Public half of the web-push key pair (scripts/setup-push.sh fills this in).
VITE_VAPID_PUBLIC_KEY=
